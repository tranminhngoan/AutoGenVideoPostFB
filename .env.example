# ==========================================
# AI NEWS STUDIO - ENVIRONMENT CONFIGURATION
# ==========================================

# ASP.NET Core Environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Database Configuration (PostgreSQL)
# Format: Host=<host>;Port=5432;Database=newsstudio_db;Username=postgres;Password=<password>
DATABASE_URL=Host=localhost;Port=5432;Database=newsstudio_db;Username=postgres;Password=postgres
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=newsstudio_db;Username=postgres;Password=postgres

# AI Configuration (Gemini or Claude)
AI_PROVIDER=Gemini
AI_API_KEY=your_gemini_or_claude_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.7
AI_TIMEOUT_SECONDS=60

# Text-To-Speech Configuration (EdgeTts, ElevenLabs, Azure, GoogleTts)
TTS_PROVIDER=EdgeTts
TTS_API_KEY=
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_SPEED=+0%
TTS_PITCH=+0Hz

# Facebook Graph API Configuration
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v20.0

# Temporary File Storage Policy (No persistent MP4 storage)
TEMP_STORAGE_PATH=./tmp/newsstudio
MAX_CONCURRENT_RENDER_JOBS=2
MAX_TEMP_STORAGE_MB=5120
TEMP_FILE_TTL_MINUTES=120
