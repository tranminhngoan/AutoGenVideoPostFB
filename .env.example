# ==========================================
# AI NEWS STUDIO - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. ASP.NET Core & Hosting Environment (Development | Production)
ASPNETCORE_ENVIRONMENT=Production
PORT=8080
FRONTEND_URL=https://your-frontend-domain.railway.app
RAILWAY_PUBLIC_DOMAIN=your-api-domain.railway.app

# 2. Database Configuration (PostgreSQL 16)
# Railway automatically populates DATABASE_URL in URI format: postgresql://postgres:password@host:port/railway
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/newsstudio_db
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=newsstudio_db;Username=postgres;Password=postgrespassword
Database__AutoMigrate=true

# 3. AI Editor & Script Planning (Gemini | Claude)
AI_PROVIDER=Gemini
AI_API_KEY=your_gemini_api_key_or_claude_api_key_here
Ai__Provider=Gemini
Ai__ApiKey=your_gemini_api_key_here
Ai__GeminiModel=gemini-1.5-flash
Ai__ClaudeModel=claude-3-5-haiku
Ai__Temperature=0.7
Ai__TimeoutSeconds=60

# 4. Vietnamese Text-To-Speech (EdgeTTS | ElevenLabs)
TTS_PROVIDER=EdgeTts
Tts__Provider=EdgeTts
Tts__Voice=vi-VN-HoaiMyNeural
Tts__Speed=+0%
Tts__Pitch=+0Hz
# If using ElevenLabs:
TTS_API_KEY=
Tts__ApiKey=

# 5. Meta Graph API (Facebook Reels Publishing)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
Facebook__AppId=
Facebook__AppSecret=
Facebook__GraphApiVersion=v21.0
Facebook__EncryptionSecretKey=YourSuperSecretAes256EncryptionKey32CharsLong!

# 6. Ephemeral Temporary Storage Policy (Strict Zero-Long-Term Media Rule)
TEMP_STORAGE_PATH=/tmp/newsstudio
Storage__TempStoragePath=/tmp/newsstudio
MAX_CONCURRENT_RENDER_JOBS=2
Storage__MaxConcurrentRenderJobs=2
MAX_TEMP_STORAGE_MB=5120
Storage__MaxTempStorageMb=5120
TEMP_FILE_TTL_MINUTES=120
Storage__TempFileTtlMinutes=120
Storage__CleanupIntervalMinutes=15

# 7. Production Hardening & Admin Security (Optional)
Security__AdminApiKey=
