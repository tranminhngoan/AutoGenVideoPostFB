{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cheo-uy-tinh", "destination": "/cheo-uy-tinh/index.html" },
    { "source": "/cheo-uy-tinh/", "destination": "/cheo-uy-tinh/index.html" },
    { "source": "/api/:path*", "destination": "https://postnewsauto.up.railway.app/api/:path*" },
    { "source": "/health", "destination": "https://postnewsauto.up.railway.app/health" },
    { "source": "/health/:path*", "destination": "https://postnewsauto.up.railway.app/health/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
