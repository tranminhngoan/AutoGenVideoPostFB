{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [Worker] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [Worker] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=newsstudio_db;Username=postgres;Password=postgres"
  },
  "Storage": {
    "TempStoragePath": "./tmp/newsstudio",
    "MaxConcurrentRenderJobs": 2,
    "MaxTempStorageMb": 5120,
    "TempFileTtlMinutes": 120
  },
  "Simulation": {
    "Enabled": false
  },
  "Ai": {
    "Provider": "Gemini",
    "Model": "gemini-flash-latest",
    "ApiKey": ""
  }
}
