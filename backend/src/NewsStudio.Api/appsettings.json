{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=newsstudio_db;Username=postgres;Password=postgres"
  },
  "Storage": {
    "TempStoragePath": "./tmp/newsstudio",
    "MaxConcurrentRenderJobs": 2,
    "MaxTempStorageMb": 5120,
    "TempFileTtlMinutes": 120
  },
  "Simulation": {
    "Enabled": false
  },
  "Ai": {
    "Provider": "Gemini",
    "Model": "gemini-flash-latest",
    "Temperature": 0.7,
    "TimeoutSeconds": 60,
    "ApiKey": "",
    "FreeApiKey": "",
    "FreeApiKey2": "",
    "FreeApiKey3": "",
    "FreeApiKey4": "",
    "FreeApiKey5": ""
  },
  "Film": {
    "FullMotion": true,
    "TargetDurationSeconds": 150,
    "MotionShare": 1.0,
    "MotionFaces": true,
    "Gpu": {
      "Enabled": true,
      "Backend": "RunPod",
      "RunPod": {
        "PodId": "",
        "ApiKey": "",
        "Port": 8888
      },
      "Kaggle": {
        "Dataset": "film-gpu-jobs",
        "Kernel": "film-gpu-worker"
      }
    }
  },
  "Tts": {
    "Provider": "EdgeTts",
    "Voice": "vi-VN-HoaiMyNeural",
    "SpeedRate": "+0%",
    "Pitch": "+0Hz"
  },
  "Facebook": {
    "AppId": "",
    "AppSecret": "",
    "PageId": "",
    "PageAccessToken": "",
    "GraphApiVersion": "v20.0"
  }
}
